{
  "name": "vobiz-pipedrive-integration",
  "version": "1.0.0",
  "description": "Vobiz browser softphone for Pipedrive: WebRTC calling with call Activities, Call Logs and recordings synced to the CRM",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "tunnel": "node backend/tunnel.js",
    "test": "node --test backend/test/*.test.js",
    "test:live": "node backend/test-pipedrive-sync.js",
    "test:answer": "node backend/test-pipedrive-sync.js --answer",
    "test:inbound": "node backend/test-pipedrive-sync.js --inbound",
    "test:recording": "node backend/test-pipedrive-sync.js --recording-proxy",
    "test:sync": "node backend/test-pipedrive-sync.js --sync-cdrs",
    "fetch-cdr": "node backend/fetch-cdr.js --sync",
    "oauth:status": "node -e \"process.loadEnvFile('./backend/.env');fetch((process.env.PUBLIC_BASE_URL||process.env.TUNNEL_URL).replace(/\\/+$/,'')+'/auth/pipedrive/status').then(r=>r.json()).then(d=>console.log(d))\""
  },
  "keywords": [
    "vobiz",
    "pipedrive",
    "crm",
    "sip",
    "voip",
    "telephony",
    "cdr",
    "call-recording",
    "webrtc"
  ],
  "author": "Vobiz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vobiz-ai/Vobiz-Pipedrive-Calling.git"
  },
  "bugs": {
    "url": "https://github.com/vobiz-ai/Vobiz-Pipedrive-Calling/issues"
  },
  "homepage": "https://github.com/vobiz-ai/Vobiz-Pipedrive-Calling#readme",
  "engines": {
    "node": ">=18.18"
  }
}
