# ─── Vobiz ───────────────────────────────────────────────────────────────────
# No Vobiz credentials go here. Agents sign in to the softphone with their own
# account's Auth ID + Auth Token (any Vobiz account works); the backend then
# creates this integration's Application and the agent's SIP endpoint in that
# account. Or they use "SIP direct" with an existing endpoint's credentials.
VOBIZ_API_URL=https://api.vobiz.ai

# Where the endpoint id/username map is kept (endpoints.json, mode 0600, no
# passwords or tokens). Default: backend/data
DATA_DIR=

# Backend listening port
PORT=8092

# Public HTTPS base URL Vobiz calls back on (your tunnel or host), no trailing
# slash. Sign-in points each account's application at <this>/answer, so it must
# be set before anyone signs in. PUBLIC_BASE_URL is accepted as an alias.
# `npm run tunnel` writes backend/tunnel-url.txt instead if this is unset.
TUNNEL_URL=

# SIP registrar the softphone registers with.
VOBIZ_REGISTRAR=registrar.vobiz.ai

# ─── Webhook signatures ──────────────────────────────────────────────────────
# Checked with the Auth Token of the account the callback belongs to (held in
# memory after that account signs in).
# verify  (default) reject a wrong signature, allow unsigned callbacks. A
#         SIP-direct call's signature cannot be checked (no token is held for
#         its account) and is treated as unsigned.
# require reject anything without a valid signature — set this once the log
#         shows "[signature] valid Vobiz signature". Incompatible with SIP direct.
# off     do not check
VOBIZ_WEBHOOK_SIGNATURES=verify

# ─── Pipedrive OAuth 2.0 ─────────────────────────────────────────────────────
# developers.pipedrive.com → Developer Hub → Create app.
PIPEDRIVE_CLIENT_ID=
PIPEDRIVE_CLIENT_SECRET=
# Must match the app's Callback URL exactly: <TUNNEL_URL>/auth/pipedrive/callback
PIPEDRIVE_REDIRECT_URI=

# Legacy personal-API-token path, off by default. Set to 1 only for an internal
# install. An app using this cannot be published on the Marketplace.
PIPEDRIVE_ALLOW_API_TOKEN=0
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_API_URL=https://api.pipedrive.com/v1

# ─── Recording link signing ──────────────────────────────────────────────────
# Playback URLs are HMAC-signed with a short expiry and carry no credentials.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If empty, a random secret is used and links die on every restart.
SIGNING_SECRET=
RECORDING_URL_TTL_SECONDS=900

# Extra browser origins allowed to call this backend, comma separated.
# https://*.pipedrive.com and localhost are allowed by default.
ALLOWED_ORIGINS=

# Set to 1 to return clearly labelled fake CRM data when Pipedrive is not
# connected. Off by default. It never bypasses sign-in.
ALLOW_MOCK=0
