# VoBiz Voice Platform Credentials
VOBIZ_AUTH_ID=YOUR_VOBIZ_AUTH_ID
VOBIZ_AUTH_TOKEN=YOUR_VOBIZ_AUTH_TOKEN
VOBIZ_FROM_NUMBER=+15550100000
VOBIZ_API_URL=https://api.vobiz.ai

# Backend Server Listening Port
PORT=8092

# Pipedrive API Credentials & Company Configuration
PIPEDRIVE_API_TOKEN=YOUR_PIPEDRIVE_PERSONAL_API_TOKEN
PIPEDRIVE_COMPANY_DOMAIN=yourcompany
PIPEDRIVE_API_URL=https://api.pipedrive.com/v1

# Public Tunnel Base URL (Optional - override auto-detected Cloudflare tunnel)
# TUNNEL_URL=https://your-custom-tunnel.trycloudflare.com
# ─── Pipedrive OAuth 2.0 (required for Marketplace) ──────────────────────────
# Create the app at developers.pipedrive.com > Developer Hub > Create public app.
# Marketplace requires OAuth and forbids collecting or storing API tokens.
PIPEDRIVE_CLIENT_ID=
PIPEDRIVE_CLIENT_SECRET=
# Must match the OAuth Callback URL registered on the app, exactly.
PIPEDRIVE_REDIRECT_URI=https://your-public-host/auth/pipedrive/callback

# Legacy personal-API-token path, off by default. Set to 1 only for an internal
# install. An app using this cannot be published on the Marketplace.
PIPEDRIVE_ALLOW_API_TOKEN=0
PIPEDRIVE_API_TOKEN=

# ─── SIP endpoint the softphone registers as ─────────────────────────────────
# NOTE: POST /Endpoint/ REWRITES the username you submit. Read the stored
# `username` back from the API response and put THAT here.
VOBIZ_SIP_USER=
VOBIZ_SIP_PASSWORD=
VOBIZ_REGISTRAR=registrar.vobiz.ai

# ─── Recording link signing ──────────────────────────────────────────────────
# Playback URLs are HMAC-signed with a short expiry and carry no credentials.
SIGNING_SECRET=
RECORDING_URL_TTL_SECONDS=900

# Extra browser origins allowed to call this backend, comma separated.
# *.pipedrive.com and localhost are allowed by default.
ALLOWED_ORIGINS=

# Set to 1 to allow fabricated CRM data when Pipedrive is not configured.
# Off by default: an unconfigured server reports failure rather than inventing
# records that look real.
ALLOW_MOCK=0
